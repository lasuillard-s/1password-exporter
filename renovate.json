{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>lasuillard-s/renovate-config"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "rust"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<compatibility>.*)$"
    },
    {
      "description": "Group non-major Rust runtime updates",
      "matchManagers": [
        "cargo"
      ],
      "matchDepTypes": [
        "dependencies",
        "build-dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Rust Runtime (non-major)",
      "groupSlug": "rust-runtime"
    },
    {
      "description": "Keep trusted Rust runtime updates in a separate automerge group",
      "matchManagers": [
        "cargo"
      ],
      "matchDepTypes": [
        "dependencies",
        "build-dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchJsonata": [
        "automerge = true"
      ],
      "groupName": "Trusted Rust Runtime (non-major)",
      "groupSlug": "trusted-rust-runtime"
    }
  ]
}
