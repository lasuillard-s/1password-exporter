{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>lasuillard-s/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Preserve Rust image minor-version precision and compatibility suffixes",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "rust"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<compatibility>.*)$"
    }
  ]
}
